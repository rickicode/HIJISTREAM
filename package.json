{
  "name": "hijistream",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "cd apps/web && bun run dev",
    "dev:server": "cd apps/server && bun run dev",
    "dev": "bun run dev:server & bun run dev:web",
    "build:web": "cd apps/web && bun run build",
    "start:server": "cd apps/server && bun run start",
    "lint": "cd apps/web && bun run lint",
    "typecheck": "cd apps/web && bun run typecheck",
    "test": "cd apps/web && bun run test"
  }
}
